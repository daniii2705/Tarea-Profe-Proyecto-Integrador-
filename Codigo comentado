    <!-- =====================================================
         SECCIÓN FINAL
    ====================================================== -->

    <section
        class="py-20 px-5 fondo-nubes">

        <div
            class="max-w-4xl mx-auto text-center">

            <div class="text-7xl">
                🧸☁️🌈✨
            </div>

            <h2
                class="text-4xl md:text-5xl font-black text-azulOscuro mt-6">

                ¡Lo hiciste genial!

            </h2>

            <p
                class="text-xl text-textoSuave font-semibold mt-5">

                Ya conoces muchas figuras.
